# Supabase (public — safe for the browser bundle)
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Cloudflare Turnstile (public site key — safe for the browser bundle).
# Leave unset for local development: the reservation form then shows a
# "verification disabled" notice instead of trying to render a widget with
# an invalid key. Set a real site key before deploying to production.
VITE_TURNSTILE_SITE_KEY=

# ---------------------------------------------------------------------------
# The following are used ONLY by the Supabase Edge Function
# (supabase/functions/create-reservation) and must be set with:
#   supabase secrets set KEY=value
# They must NEVER be prefixed with VITE_ and must NEVER reach the browser.
# ---------------------------------------------------------------------------
# SUPABASE_URL=https://YOUR-PROJECT.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# TURNSTILE_SECRET_KEY=your-turnstile-secret-key
